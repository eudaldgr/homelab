[Unit]
Description=Pangolin Service
After=network.target

[Container]
Pod=pangolin_proxy_1.pod
ContainerName=pangolin_app_1
Image=ghcr.io/fosrl/pangolin:{{ pangolin_app_version }}
Mount=type=bind,src=/etc/pangolin,dst=/app/config,relabel=shared,U=true
Notify=healthy
HealthCmd="/usr/bin/curl -f http://127.0.0.1:3001/api/v1/"
HealthInterval=3s
HealthRetries=15
HealthTimeout=15s

[Service]
Restart=always

[Install]
WantedBy=default.target
