CONFIG_TIMESTAMPS_ON_CONSOLE=y
CONFIG_BOOTSPLASH_IMAGE=y
CONFIG_SBOM=y
CONFIG_SBOM_COMPILER=y
CONFIG_SBOM_PAYLOAD=y
CONFIG_SBOM_MICROCODE=y
CONFIG_VENDOR_LENOVO=y
CONFIG_NO_POST=y
