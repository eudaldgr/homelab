{
  "ignition": {
    "version": "3.2.0"
  },
  "passwd": {
    "users": [
      {
        "name": "eudaldgr",
        "groups": [
          "systemd-journal",
          "users"
        ],
        "sshAuthorizedKeys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMtFEdSmdo2wOh1CLWQ7deWuCpvuGceoP9pD6lDRfPVc"
        ]
      }
    ]
  },
  "storage": {
    "filesystems": [
      {
        "device": "/dev/disk/by-label/ROOT",
        "format": "btrfs",
        "mountOptions": [
          "subvol=/@/home"
        ],
        "path": "/home",
        "wipeFilesystem": false
      }
    ],
    "files": [
      {
        "path": "/etc/sudoers.d/40-ignition",
        "mode": 440,
        "user": {
          "name": "root"
        },
        "group": {
          "name": "root"
        },
        "contents": {
          "source": "data:text/plain;charset=utf-8;base64,ZXVkYWxkZ3IgQUxMPShBTEwpIE5PUEFTU1dEOkFMTA=="
        }
      },
      {
        "path": "/etc/hostname",
        "mode": 420,
        "overwrite": true,
        "contents": {
          "source": "data:,k3s-server-03"
        }
      },
      {
        "path": "/etc/repart.d/10-root.conf",
        "mode": 384,
        "overwrite": true,
        "contents": {
          "source": "data:text/plain;charset=utf-8;base64,W1BhcnRpdGlvbl0KVHlwZT1yb290Cg==",
          "human_read": "[Partition]\nType=root\n"
        }
      }
    ]
  }
}