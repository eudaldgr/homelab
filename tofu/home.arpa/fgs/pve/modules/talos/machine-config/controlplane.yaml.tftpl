machine:
  certSANs:
%{ for san in cert_sans ~}
    - ${san}
%{ endfor ~}

  features:
    # Allow the tuppr upgrade controller (system-upgrade namespace) to call the Talos API.
    kubernetesTalosAPIAccess:
      enabled: true
      allowedRoles:
        - os:admin
      allowedKubernetesNamespaces:
        - system-upgrade

  kubelet:
    clusterDNS:
      - 10.43.0.10
    extraArgs:
      rotate-server-certificates: true
    extraConfig:
      imageMinimumGCAge: 1h
      evictionHard:
        memory.available: 500Mi
        nodefs.available: 5%
        imagefs.available: 1Gi
      evictionSoft:
        memory.available: 1Gi
        nodefs.available: 10%
        imagefs.available: 2Gi
      evictionSoftGracePeriod:
        memory.available: 1m
        nodefs.available: 2m
        imagefs.available: 5m
      kubeReserved:
        memory: 512Mi
      systemReserved:
        memory: 256Mi

%{ if igpu ~}
  sysctls:
    vm.nr_hugepages: "0"

  kernel:
    modules:
      - name: vfio_pci
      - name: i915
%{ endif ~}

  network:
    interfaces:
      - interface: net0
        dhcp: true
        vip:
          ip: ${vip}

  nodeLabels:
    topology.kubernetes.io/region: ${proxmox_cluster_name}
    topology.kubernetes.io/zone: ${node_name}
    kubearmor.io/enforcer: bpf
    kubearmor.io/runtime: containerd
    kubearmor.io/socket: run_containerd_containerd.sock
    kubearmor.io/btf: "yes"
    kubearmor.io/seccomp: "yes"
    kubearmor.io/apparmorfs: "no"
    kubearmor.io/securityfs: "yes"
    kubearmor.io/rand: talos-static

cluster:
  clusterName: ${cluster_name}
  allowSchedulingOnControlPlanes: ${schedule_workloads}

  coreDNS:
    disabled: true

  apiServer:
    extraArgs:
      default-watch-cache-size: "100"

  controllerManager:
    extraArgs:
      concurrent-service-syncs: "1"
      concurrent-deployment-syncs: "1"

  etcd:
    extraArgs:
      quota-backend-bytes: "1073741824"
      auto-compaction-retention: "1"
      auto-compaction-mode: "periodic"
      snapshot-count: "50000"
      heartbeat-interval: "500"
      election-timeout: "5000"

  network:
    cni:
      name: none
    dnsDomain: cluster.local
    podSubnets:
      - 10.42.0.0/16
    serviceSubnets:
      - 10.43.0.0/16

  proxy:
    disabled: true

  extraManifests:
    - https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.4.1/standard-install.yaml # renovate: github-releases=kubernetes-sigs/gateway-api
    - https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v1.4.1/config/crd/experimental/gateway.networking.k8s.io_tlsroutes.yaml # renovate: github-releases=kubernetes-sigs/gateway-api
    - https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v1.4.1/config/crd/experimental/gateway.networking.k8s.io_udproutes.yaml # renovate: github-releases=kubernetes-sigs/gateway-api
    - https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v1.4.1/config/crd/experimental/gateway.networking.k8s.io_tcproutes.yaml # renovate: github-releases=kubernetes-sigs/gateway-api
    - https://raw.githubusercontent.com/alex1989hu/kubelet-serving-cert-approver/main/deploy/standalone-install.yaml
    - https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml

---
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: ${hostname}

---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: mac(link.permanent_addr) == "${mac}"

%{ if storage_enabled ~}
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: storage0
selector:
  match: mac(link.permanent_addr) == "${storage_mac}"

---
apiVersion: v1alpha1
kind: LinkConfig
name: storage0
up: true
mtu: 1500
addresses:
  - address: ${storage_ip}/24
%{ endif ~}
