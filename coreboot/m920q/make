#!/bin/sh

dw()
{
    if [ -z "$(ls -A "$COREBOOT_BUILD_DIR" 2>/dev/null)" ]; then
        git clone --branch "$COREBOOT_TAG" "$_url" "$COREBOOT_BUILD_DIR"

        cd "$COREBOOT_BUILD_DIR"
        #gpg --receive-keys "574C E6F6 855C FDEB 7D36  8E9D 1979 6C2B 3E4F 7DF7"
        #git verify-tag "$COREBOOT_TAG"
        #git submodule update --init --recursive --remote

        git clone "https://review.coreboot.org/blobs"           3rdparty/blobs
        git clone "https://review.coreboot.org/intel-microcode" 3rdparty/intel-microcode
    elif [ -d "$COREBOOT_BUILD_DIR/.git" ]; then
        if [ "$($_chk)" = "$COREBOOT_TAG" ]; then
            printf '%s\n' "Already on tag $COREBOOT_TAG"
            return 0
        fi

        cd "$COREBOOT_BUILD_DIR"                          && git fetch --all --tags --prune

        [ -z "$(ls -A "$COREBOOT_BUILD_DIR/3rdparty/blobs" 2>/dev/null)" ] &&
            git clone "https://review.coreboot.org/blobs"           3rdparty/blobs

        [ -z "$(ls -A "$COREBOOT_BUILD_DIR/3rdparty/intel-microcode" 2>/dev/null)" ] &&
            git clone "https://review.coreboot.org/intel-microcode" 3rdparty/intel-microcode

        cd "$COREBOOT_BUILD_DIR/3rdparty/blobs"           && git fetch --all --tags --prune
        cd "$COREBOOT_BUILD_DIR/3rdparty/intel-microcode" && git fetch --all --tags --prune

        cd "$COREBOOT_BUILD_DIR"
        git checkout "$_tag"
        git submodule update --recursive --remote
    else
        printf '%s\n' "Error: $COREBOOT_BUILD_DIR is not a git repository and is not empty."
        exit 1
    fi
}

px()
{
    # Update iPXE payload to a more recent version, default version not suitable
    cd "$COREBOOT_BUILD_DIR"

    sed 's/2023.8/2024.12/' payloads/external/iPXE/Kconfig > _
    mv _ payloads/external/iPXE/Kconfig

    sed 's/^STABLE_COMMIT_ID=.*/STABLE_COMMIT_ID=8b8a50a85d4763da6d353719d6022d01c7a09751/' payloads/external/iPXE/Makefile > _
    mv _ payloads/external/iPXE/Makefile

    # Apply 85161: soc/intel: Assert if `pmc_/gpe0_dwX` values are not unique | https://review.coreboot.org/c/coreboot/+/85161
    # wget -O 85161-pmc-gpe0.patch https://github.com/coreboot/coreboot/commit/640a41f3ee938b794b140218921e0fd63b1d9235.patch
    # patch -p1 < 85161-pmc-gpe0.patch

    # Apply 86164: soc/intel: Allow zero values for PMC GPE0 DW registers | https://review.coreboot.org/c/coreboot/+/86164
    # wget -O 86164-pmc-gpe0.patch https://github.com/coreboot/coreboot/commit/bfb04753867defde6b0b9557dbfd263feda99fcd.patch
    # patch -p1 < 86164-pmc-gpe0.patch

    # Revert 85161: soc/intel: Assert if `pmc_/gpe0_dwX` values are not unique | https://review.coreboot.org/c/coreboot/+/85161
    # wget -O 85161-pmc-gpe0.patch https://github.com/coreboot/coreboot/commit/640a41f3ee938b794b140218921e0fd63b1d9235.patch
    # patch -p1 -R --force < 85161-pmc-gpe0.patch
    # git revert 640a41f3ee938b794b140218921e0fd63b1d9235
